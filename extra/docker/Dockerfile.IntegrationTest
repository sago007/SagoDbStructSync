FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libboost-dev \
    libboost-program-options-dev \
    libboost-filesystem-dev \
    libboost-system-dev \
    libboost-test-dev \
    libcppdb-dev \
    mysql-client \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /staging
COPY . /staging

RUN cd /staging && cmake . && make

CMD ["bash", "/staging/extra/docker/integration/run_tests.sh"]
